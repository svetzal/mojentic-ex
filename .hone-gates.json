{
  "gates": [
    {
      "name": "format",
      "command": "scripts/recovery-mix format --check-formatted",
      "required": true
    },
    {
      "name": "compile",
      "command": "scripts/recovery-mix compile --warnings-as-errors",
      "required": true
    },
    {
      "name": "credo",
      "command": "scripts/recovery-mix credo --strict",
      "required": true
    },
    {
      "name": "test",
      "command": "scripts/recovery-mix test --cover",
      "required": true
    },
    {
      "name": "deps-audit",
      "command": "scripts/recovery-mix deps.audit",
      "required": false
    },
    {
      "name": "sobelow",
      "command": "scripts/recovery-mix sobelow --config",
      "required": false
    }
  ]
}
