#!/usr/bin/env bash
# Keep every test and verification script independent of live infrastructure.
set -euo pipefail
cd "$(dirname "$0")/.."
# Character classes preserve matches without matching this declaration as input.
patterns='Process[.]sleep|:timer[.](sleep|tc)|System[.](monotonic_time|system_time)|:gen[_]tcp[.]|:ssl[.]|TCP[S]erver|HTTP[S]erver|from[_]pretrained|TokenizerGateway[.]new[!(]'
# Collect filenames separately so grep's no-match status is distinct from errors.
mapfile -d '' -t surface < <(find test scripts -type f ! -name verify-offline-test-surface -print0)
mapfile -d '' -t tests < <(find test -type f -name '*.exs' -print0)
mapfile -d '' -t scripts < <(find scripts -type f ! -name verify-offline-test-surface -print0)
scan() {
  local status=0
  grep -nHE -- "$@" || status=$?
  case "$status" in
    0) return 0 ;;
    1) return 1 ;;
    *) echo 'Offline scanner could not inspect its inputs.' >&2; exit "$status" ;;
  esac
}
if scan "$patterns" "${surface[@]}"; then
  echo 'Offline test surface contains a real clock, sleeper, socket or model download.' >&2
  exit 1
fi
if scan 'assert.*(duration_ms|elapsed_ms).*[<>]' "${tests[@]}"; then
  echo 'Assert timing values from an injected clock, not wall-clock thresholds.' >&2
  exit 1
fi
if scan '^[[:space:]]*(curl|wget|mix deps[.]get|mix hex[.](repo|registry))([^[:alnum:]_]|$)' "${scripts[@]}"; then
  echo 'Verification scripts must use local dependencies and registry snapshots.' >&2
  exit 1
fi
echo 'Offline test/script surface: no explicit real clocks, sleeps, sockets or service/registry calls.'
