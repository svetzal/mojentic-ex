#!/usr/bin/env bash
# Local adapter and Broker/ChatSession verification; external servers/consumers
# must verify this same executable set in their own authorized repositories.
set -euo pipefail
cd "$(dirname "$0")/.."
echo 'request-fidelity-v1'
git rev-parse HEAD
sha256sum lib/mojentic/llm/completion_config.ex lib/mojentic/llm/chat_session.ex \
  lib/mojentic/llm/broker.ex lib/mojentic/llm/gateways/{openai,openai_model_registry,ollama,omlx}.ex \
  lib/mojentic/tracer/tracer_events.ex mix.lock
sha256sum test/contracts/request_fidelity_v1.json \
  test/mojentic/llm/immutable_request_wire_test.exs \
  test/mojentic/llm/gateways/openai_model_registry_test.exs \
  test/support/scripted_completion_server.ex test/support/counting_tool.ex
exec scripts/recovery-mix test test/mojentic/llm/immutable_request_wire_test.exs \
  test/mojentic/llm/gateways/openai_model_registry_test.exs "$@"
