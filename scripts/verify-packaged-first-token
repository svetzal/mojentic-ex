#!/usr/bin/env bash
# Consume the local Hex payload against ex-readiness-v1; never publish it.
# The historical command name remains stable for existing project gates.
set -euo pipefail
cd "$(dirname "$0")/.."
source_root="$PWD"
mix_runner="${MOJENTIC_MIX:-$source_root/scripts/recovery-mix}"
mkdir -p "$source_root/.foundry"
consumer_root="$(mktemp -d "$source_root/.foundry/consumer.XXXXXX")"
trap 'rm -rf "$consumer_root"' EXIT
export HEX_HOME="$source_root/.foundry/runtime/hex"
export XDG_CACHE_HOME="$source_root/.foundry/runtime/cache"

echo "ex-readiness-v1 packaged consumer"
git rev-parse HEAD
sha256sum --check test/contracts/readiness_v1.manifest.sha256
mapfile -t contract_tests < test/contracts/readiness_v1.files
"$mix_runner" hex.build --output "$consumer_root/mojentic.tar"
sha256sum "$consumer_root/mojentic.tar"
mkdir -p "$consumer_root/package" "$consumer_root/consumer/test/support"
tar -xf "$consumer_root/mojentic.tar" -C "$consumer_root" contents.tar.gz
tar -xzf "$consumer_root/contents.tar.gz" -C "$consumer_root/package"
cat > "$consumer_root/consumer/mix.exs" <<'ELIXIR'
defmodule ReadinessConsumer.MixProject do
  use Mix.Project
  def project do
    [app: :readiness_consumer, version: "0.0.0", elixirc_paths: ["test/support"],
     deps: [{:mojentic, path: "../package"}, {:mox, "~> 1.2", only: :test}]]
  end
  def application, do: [extra_applications: [:logger]]
end
ELIXIR
cp mix.lock "$consumer_root/consumer/mix.lock"
cp test/test_helper.exs "$consumer_root/consumer/test/"
for contract_test in "${contract_tests[@]}"; do
  mkdir -p "$consumer_root/consumer/$(dirname "$contract_test")"
  cp "$contract_test" "$consumer_root/consumer/$contract_test"
done
cp -R test/contracts "$consumer_root/consumer/test/"
cp test/support/*.ex "$consumer_root/consumer/test/support/"
cp -R test/fixtures "$consumer_root/consumer/test/"
cd "$consumer_root/consumer"
"$mix_runner" deps.get
"$mix_runner" test "${contract_tests[@]}" "$@"
