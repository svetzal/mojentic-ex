#!/usr/bin/env bash
# Library self-validation; fresh payload consumption uses ex-readiness-v1.
set -euo pipefail
cd "$(dirname "$0")/.."
echo 'omlx-keepalive-v1'
sha256sum scripts/verify-omlx-keepalive-contract \
  test/mojentic/llm/omlx_keepalive_wire_test.exs \
  test/mojentic/llm/stream_recovery_wire_test.exs \
  test/support/scripted_completion_server.ex
exec scripts/recovery-mix test test/mojentic/llm/omlx_keepalive_wire_test.exs \
  test/mojentic/llm/stream_recovery_wire_test.exs --only omlx_keepalive_contract "$@"
