#!/usr/bin/env bash
# Source public consumers and packaged consumers execute the same frozen cases.
set -euo pipefail
cd "$(dirname "$0")/.."
echo 'ex-readiness-v1 source consumer'
git rev-parse HEAD
sha256sum --check test/contracts/readiness_v1.manifest.sha256
mapfile -t contract_tests < test/contracts/readiness_v1.files
exec "${MOJENTIC_MIX:-scripts/recovery-mix}" test "${contract_tests[@]}" "$@"
