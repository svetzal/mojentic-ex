#!/usr/bin/env bash
# Library self-validation; fresh payload consumption uses ex-readiness-v1.
set -euo pipefail
cd "$(dirname "$0")/.."
echo 'retry-after-dates-v2'
sha256sum test/mojentic/llm/retry_after_dates_wire_test.exs \
  test/mojentic/llm/recovery_wire_test.exs \
  test/support/scripted_transport.ex
exec scripts/recovery-mix test test/mojentic/llm/retry_after_dates_wire_test.exs \
  test/mojentic/llm/recovery_wire_test.exs "$@"
